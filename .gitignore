# Environment files (keep only .env.example)
.env
.env.*
!.env.example

# SQLite databases and runtime artifacts
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Terraform state and sensitive variables
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
!terraform.tfvars.example

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.adk/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
