# ============================================================================
# Environment & Runtime Mode
# ============================================================================
# Execution environment: local | dev | prod
APP_ENV=local

# Gemini API key (leave empty in production; fetched via GCP Secret Manager)
GOOGLE_API_KEY=

# Use Vertex AI backend instead of Google AI Studio when true
GOOGLE_GENAI_USE_VERTEXAI=false

# Google Cloud project and region
GOOGLE_CLOUD_PROJECT=ono-project-sandbox-55800
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================================================
# Strategic Model Routing (Rubric #10 - No hardcoded model IDs in code)
# ============================================================================
# Low-latency model for orchestration, triage, and high-throughput tasks
FAST_MODEL=gemini-3-flash-preview

# Deep reasoning model for evidence synthesis and methodological critique
REASONING_MODEL=gemini-3.1-pro-preview-customtools

# Model used by evaluation judges and rubric grading
JUDGE_MODEL=gemini-3-flash-preview

# ============================================================================
# Session Persistence, Compaction & Memory (Rubric #6, #7, #8)
# ============================================================================
# Async SQLAlchemy URL required by ADK DatabaseSessionService
SESSION_DB_URL=sqlite+aiosqlite:///./sessions.db

# Vertex AI Agent Engine resource ID (optional, used in cloud deployment)
AGENT_ENGINE_ID=

# Number of turns between automatic context compactions
COMPACTION_INTERVAL=3

# Number of overlapping turns preserved during compaction
COMPACTION_OVERLAP=1

# Strict temporal window (in years) for Alzheimer's literature retrieval
RECENCY_YEARS=3

# ============================================================================
# Guardrails, Policy Plugins, HITL & PII Redaction (Rubric #11, #12, #16)
# ============================================================================
# GCP Model Armor template resource names (leave empty to use local policy fallback)
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=

# Whether Model Armor screening errors block execution
BLOCK_ON_SCREENING_FAILURE=false

# Human-in-the-loop gate mode: adk_confirmation | auto_approve_for_eval
HITL_MODE=adk_confirmation

# PII redaction backend: local | dlp
PII_MODE=local

# ============================================================================
# Observability, Structured Logging & Tracing (Rubric #13, #14, #15)
# ============================================================================
# Export OpenTelemetry spans to Google Cloud Trace when true
OTEL_TO_CLOUD=false

# Logical service name for OpenTelemetry traces and structured JSON logs
OTEL_SERVICE_NAME=alz-recent-research-agent

# Minimum log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ============================================================================
# Biomedical Literature APIs & Secret Management (Rubric #19)
# ============================================================================
# NCBI E-utilities identification parameters (required by PubMed policy)
NCBI_TOOL_NAME=alz-recent-research-agent
NCBI_CONTACT_EMAIL=researcher@example.com

# Optional API keys (leave empty in .env; loaded from Secret Manager in cloud)
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
