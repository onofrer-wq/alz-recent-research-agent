# Rubric #18 (Infrastructure as Code): Example Terraform variable values (no sensitive values).
# Copy to terraform.tfvars for local applies; never commit terraform.tfvars.

project_id        = "ono-project-sandbox-55800"
region            = "us-central1"
service_name      = "alz-recent-research-agent"
github_repository = "onofrer-wq/alz-recent-research-agent"
container_image   = "us-central1-docker.pkg.dev/ono-project-sandbox-55800/alz-recent-research-agent/agent:latest"
fast_model        = "gemini-3-flash-preview"
reasoning_model   = "gemini-3.1-pro-preview-customtools"
recency_years     = 3
